{
  "$schema": "https://schema.tauri.app/config/2.0",
  "bundle": {
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/bin/": "resources/bin/",
      "../legal/": "legal/",
      "../release-notes/": "release-notes/",
      "windows/identity/dist/HybridCipher.identity.msix": "HybridCipher.identity.msix",
      "windows/identity/dist/register-identity.ps1": "register-identity.ps1",
      "windows/identity/dist/Assets/": "Assets/"
    },
    "windows": {
      "certificateThumbprint": "REPLACE_WITH_WINDOWS_CODE_SIGNING_CERTIFICATE_THUMBPRINT",
      "digestAlgorithm": "sha256",
      "timestampUrl": "https://timestamp.digicert.com",
      "nsis": {
        "installerHooks": "windows/identity/nsis-hooks.nsh"
      },
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "windows/identity/wix-identity.wxs"
        ],
        "componentGroupRefs": [
          "HybridCipherIdentityIntegrationGroup"
        ]
      }
    }
  }
}
